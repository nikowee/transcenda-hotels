# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — THIS FILE IS COMMITTED TO GIT.
#
# .gitignore ignores .env but explicitly un-ignores .env.example, so anything
# written below is published to the repository. Never put a real value here.
#
#   cp server/.env.example server/.env      # then fill in server/.env
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000

# Supabase project URL and service-role key. The secret key bypasses Row Level
# Security entirely, so it belongs in .env and nowhere else.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Where the browser reaches the frontend. Used to build Stripe return URLs.
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Stripe. Required whenever NODE_ENV=production — the server refuses to start
# without STRIPE_SECRET_KEY there, rather than silently accepting every card.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local development only. Set to "simulate" to walk the booking flow without
# Stripe credentials; ignored when NODE_ENV=production. Leave blank otherwise.
PAYMENTS_MODE=

# Set to "fetch" to use Stripe's fetch-based HTTP client instead of the default
# Node one. The test suite sets it so nock can intercept: Stripe's NodeHttpClient
# waits for a socket "secureConnect" that nock never emits, and the request hangs.
# Leave blank in development and production to keep the keep-alive agent.
STRIPE_HTTP_CLIENT=

# Set to "memory" to keep bookings in-process instead of Supabase. Checked
# before SUPABASE_URL/SUPABASE_SECRET_KEY, so leaving it set sends bookings to
# the in-process store even with valid credentials — nothing reaches the
# database. That store is cleared on restart, and `npm run dev` restarts on
# every file save, so a booking made before a save 404s on the confirmation
# page. Leave blank to persist to Supabase.
BOOKINGS_STORAGE=
