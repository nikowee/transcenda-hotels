# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — THIS FILE IS COMMITTED TO GIT.
#
# .gitignore ignores .env but explicitly un-ignores .env.example, so anything
# written below is published to the repository. Never put a real value here.
#
#   cp server/.env.example server/.env      # then fill in server/.env
#
# This is the complete set the server reads from .env. REDIS_URL and NODE_ENV
# are deployment-injected (docker-compose / the platform), not .env entries.
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000

# Supabase project URL and service-role key. The secret key bypasses Row Level
# Security entirely, so it belongs in .env and nowhere else.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe. Required whenever NODE_ENV=production — the server refuses to start
# without STRIPE_SECRET_KEY there, rather than silently accepting every card.
STRIPE_SECRET_KEY=

# Signing key for POST /api/webhooks/stripe. In production this is the value
# Stripe shows when you add the endpoint. Locally it can be any secret, because
# verification is an HMAC over bytes we already hold and never calls Stripe:
#
#   npm run stripe:secret -- --write    generate one and write it here
#   npm run stripe:send                 deliver a signed event to localhost
#
# Unset, the endpoint answers 503 and keeps Stripe retrying.
STRIPE_WEBHOOK_SECRET=

# Local development only. Set to "simulate" to walk the booking flow without
# Stripe credentials; ignored when NODE_ENV=production. Leave blank otherwise.
PAYMENTS_MODE=

# Set to "memory" to keep bookings in-process instead of Supabase. That store
# is cleared on restart, and `npm run dev` restarts on every file save — a
# booking made before a save 404s on the confirmation page. Leave blank to
# persist to Supabase.
BOOKINGS_STORAGE=

# Where the browser reaches the frontend. Used to build Stripe return URLs.
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000