# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — THIS FILE IS COMMITTED TO GIT.
#
# .gitignore ignores .env but explicitly un-ignores .env.example, so anything
# written below is published to the repository. Never put a real value here.
#
#   cp server/.env.example server/.env      # then fill in server/.env
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000

# Supabase project URL and service-role key. The secret key bypasses Row Level
# Security entirely, so it belongs in .env and nowhere else.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# How long a verified access token is trusted without re-asking Supabase, in ms.
# Default 60 seconds. This is the window in which a signed-out session still
# looks live, traded against a round trip to Supabase in the middle of the
# payment funnel — a signed-in guest mints a payment intent and confirms it
# seconds apart. Leave blank for the default; set to 0 to verify every request.
AUTH_CACHE_MS=

# Where the browser reaches the frontend. Used to build Stripe return URLs.
APP_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Stripe. Required whenever NODE_ENV=production — the server refuses to start
# without STRIPE_SECRET_KEY there, rather than silently accepting every card.
STRIPE_SECRET_KEY=

# Signing key for POST /api/webhooks/stripe. In production this is the value
# Stripe shows when you add the endpoint. Locally it can be any secret, because
# verification is an HMAC over bytes we already hold and never calls Stripe:
#
#   npm run stripe:secret -- --write    generate one and write it here
#   npm run stripe:send                 deliver a signed event to localhost
#
# That pair replaces `stripe listen` / `stripe trigger` when the Stripe CLI is
# not installed. Unset, the endpoint answers 503 and keeps Stripe retrying.
STRIPE_WEBHOOK_SECRET=

# Local development only. Set to "simulate" to walk the booking flow without
# Stripe credentials; ignored when NODE_ENV=production. Leave blank otherwise.
PAYMENTS_MODE=

# Set to "fetch" to use Stripe's fetch-based HTTP client instead of the default
# Node one. The test suite sets it so nock can intercept: Stripe's NodeHttpClient
# waits for a socket "secureConnect" that nock never emits, and the request hangs.
# Leave blank in development and production to keep the keep-alive agent.
STRIPE_HTTP_CLIENT=

# Ascenda's hotel API, which supplies the room rates a booking is priced from.
# Leave blank for the public endpoint; point it at a proxy or a stub to override.
# The four demo room slugs (standard-queen, deluxe-king, executive-suite,
# family-room) are priced in-process and never reach it, so the booking flow
# still works with no network at all.
HOTEL_API_URL=

# Room price searches answer "still searching" before they answer with rooms, so
# they have to be polled. Defaults: 1200ms apart, 8 attempts.
HOTEL_API_POLL_MS=
HOTEL_API_MAX_POLLS=

# How long a priced stay is held, in ms. Default 30 minutes. This is a
# correctness setting, not a performance one: a stay is priced once to display,
# once to charge and once to confirm, and those three have to agree or the
# confirm-time amount check rejects a charge that already succeeded.
HOTEL_API_CACHE_MS=

# Set to "memory" to keep bookings in-process instead of Supabase. Checked
# before SUPABASE_URL/SUPABASE_SECRET_KEY, so leaving it set sends bookings to
# the in-process store even with valid credentials — nothing reaches the
# database. That store is cleared on restart, and `npm run dev` restarts on
# every file save, so a booking made before a save 404s on the confirmation
# page. Leave blank to persist to Supabase.
BOOKINGS_STORAGE=

# ─────────────────────────────────────────────────────────────────────────────
# Feature 2 (search) and Feature 3 (hotel details)
# ─────────────────────────────────────────────────────────────────────────────

# Ascenda base URL used by hotelController. Note this is a second spelling of
# the same upstream that HOTEL_API_URL above points at — the two arrived on
# different branches and are worth collapsing into one.
ASC_BASE_API_URL=https://hotelapi.loyalty.dev/api/hotels

# Redis, used to cache hotel search results.
REDIS_URL=redis://localhost:6379
REDIS_TTL=300
