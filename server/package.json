  "main": "index.js",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "mocha --exit -r tsx src/tests/**/*.test.ts",
    "test:watch": "mocha --exit -r tsx --watch src/tests/**/*.test.ts --exclude 'tests/integration/**'",
    "test:integration": "mocha --import tsx 'tests/integration/**/*.test.ts'",
    "test:all": "mocha --import tsx 'tests/**/*.test.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
