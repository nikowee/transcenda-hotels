    "fuse.js": "^7.5.0",
    "redis": "^6.1.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/nock": "^10.0.3",
    "@types/node": "^26.1.1",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "nock": "^14.0.16",
    "sinon": "^22.1.0",
