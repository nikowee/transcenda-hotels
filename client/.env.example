# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — THIS FILE IS COMMITTED TO GIT.
#
# .gitignore ignores .env but explicitly un-ignores .env.example, so anything
# written below is published to the repository. Never put a real value here.
#
#   cp client/.env.example client/.env      # then fill in client/.env
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser reaches the Express API.
VITE_API_URL=http://localhost:5000

# Supabase project URL and the PUBLISHABLE (anon) key — never the secret one.
# Anything VITE_-prefixed is inlined into the client bundle and is world-readable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key, for mounting Elements on the payment page. Also
# world-readable by design; the secret key lives only in server/.env.
# Leave blank to fall back to the demo card form (PAYMENTS_MODE=simulate).
VITE_STRIPE_PUBLISHABLE_KEY=
